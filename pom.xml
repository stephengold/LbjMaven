<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.github.stephengold.lbjmaven</groupId>
    <artifactId>LbjMaven</artifactId>
    <version>1.0.0-SNAPSHOT</version>

    <name>LbjMaven</name>
    <url>https://github.com/stephengold/LbjMaven</url>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>8</maven.compiler.release>
    </properties>

    <dependencies>
        <!-- JVM libraries (required at compile time): -->
        <dependency>
            <groupId>com.github.stephengold</groupId>
            <artifactId>Libbulletjme-Windows64</artifactId>
            <version>23.2.0</version>
            <scope>compile</scope>
        </dependency>
        <dependency>
            <groupId>io.github.electrostat-lab</groupId>
            <artifactId>snaploader</artifactId>
            <version>1.1.1-stable</version>
            <scope>compile</scope>
        </dependency>

        <!-- Linux natives: -->
        <dependency>
            <groupId>com.github.stephengold</groupId>
            <artifactId>Libbulletjme-Linux64</artifactId>
            <version>23.2.0</version>
            <classifier>SpDebug</classifier>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>com.github.stephengold</groupId>
            <artifactId>Libbulletjme-Linux_ARM32hf</artifactId>
            <version>23.2.0</version>
            <classifier>SpDebug</classifier>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>com.github.stephengold</groupId>
            <artifactId>Libbulletjme-Linux_ARM64</artifactId>
            <version>23.2.0</version>
            <classifier>SpDebug</classifier>
            <scope>runtime</scope>
        </dependency>

        <!-- macOS natives: -->
        <dependency>
            <groupId>com.github.stephengold</groupId>
            <artifactId>Libbulletjme-MacOSX64</artifactId>
            <version>23.2.0</version>
            <classifier>SpDebug</classifier>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>com.github.stephengold</groupId>
            <artifactId>Libbulletjme-MacOSX_ARM64</artifactId>
            <version>23.2.0</version>
            <classifier>SpDebug</classifier>
            <scope>runtime</scope>
        </dependency>

        <!-- Windows natives: -->
        <dependency>
            <groupId>com.github.stephengold</groupId>
            <artifactId>Libbulletjme-Windows64</artifactId>
            <version>23.2.0</version>
            <classifier>SpDebug</classifier>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>com.github.stephengold</groupId>
            <artifactId>Libbulletjme-Windows_ARM64</artifactId>
            <version>23.2.0</version>
            <classifier>SpDebug</classifier>
            <scope>runtime</scope>
        </dependency>
    </dependencies>

    <build>
        <pluginManagement><!-- lock down plugins versions to avoid using Maven defaults -->
            <plugins>
                <!-- clean lifecycle, see https://maven.apache.org/ref/current/maven-core/lifecycles.html#clean_Lifecycle -->
                <plugin>
                    <artifactId>maven-clean-plugin</artifactId>
                    <version>3.5.0</version>
                </plugin>
                <!-- default lifecycle, jar packaging: see https://maven.apache.org/ref/current/maven-core/default-bindings.html#Plugin_bindings_for_jar_packaging -->
                <plugin>
                    <artifactId>maven-resources-plugin</artifactId>
                    <version>3.5.0</version>
                </plugin>
                <plugin>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.16.0</version>
                </plugin>
                <plugin>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.6.0</version>
                </plugin>
                <plugin>
                    <artifactId>maven-jar-plugin</artifactId>
                    <version>3.5.1</version>
                </plugin>
                <plugin>
                    <artifactId>maven-install-plugin</artifactId>
                    <version>3.2.0</version>
                </plugin>
                <plugin>
                    <artifactId>maven-deploy-plugin</artifactId>
                    <version>3.2.0</version>
                </plugin>
                <!-- site lifecycle, see https://maven.apache.org/ref/current/maven-core/lifecycles.html#site_Lifecycle -->
                <plugin>
                    <artifactId>maven-site-plugin</artifactId>
                    <version>3.22.0</version>
                </plugin>
                <plugin>
                    <artifactId>maven-project-info-reports-plugin</artifactId>
                    <version>3.9.0</version>
                </plugin>
                <plugin>
                    <groupId>org.codehaus.mojo</groupId>
                    <artifactId>exec-maven-plugin</artifactId>
                    <version>3.6.4</version>
                    <configuration>
                        <mainClass>com.github.stephengold.lbjmaven.HelloLibbulletjme</mainClass>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
